{
  "manifest_version": 3,
  "name": "Aquaman (perso)",
  "short_name": "Aquaman perso",
  "version": "1.4.0",
  "description": "Compagnon Poseidon Scans : Aquaman nettoyé (sans serveur externe) + Alertes Marché + Vente auto.",
  "author": "Teddy (Aquaman d'après A-Finch13, MIT)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Aquaman (perso)",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://poseidon-scans.net/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://poseidon-scans.net/*"
      ],
      "js": [
        "src/content/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://poseidon-scans.net/*"
      ],
      "js": [
        "src/content/tutorial.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}