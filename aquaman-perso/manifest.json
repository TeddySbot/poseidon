{
  "manifest_version": 3,
  "name": "Aquaman (perso)",
  "short_name": "Celestial",
  "version": "2.0.0",
  "description": "Celestial, compagnon Poseidon Scans : Aquaman nettoyé (sans serveur externe) + Alertes Marché + Vente auto + Compléter ma collection + Ma progression + Mes doubles.",
  "author": "Teddy (Aquaman d'après A-Finch13, MIT)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Celestial",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://poseidon-scans.net/*",
    "https://api.github.com/*",
    "https://aquaman-relay.finch-arhold-git.workers.dev/*"
  ]
}
