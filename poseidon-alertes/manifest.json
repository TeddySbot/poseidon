{
  "manifest_version": 3,
  "name": "Poseidon – Alertes Marché",
  "version": "1.1.0",
  "description": "Surveille le marché du jeu de cartes Poseidon Scans et t'avertit sur ton bureau quand une carte recherchée est en vente.",
  "permissions": ["notifications", "storage", "alarms"],
  "host_permissions": ["https://poseidon-scans.net/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alertes Marché Poseidon",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
