{
  "manifest_version": 3,
  "name": "Poseidon – Vente auto",
  "version": "1.3.0",
  "description": "Met en vente automatiquement tes Communes, Rares (et Épiques) en double recherchées sur le marché Poseidon Scans.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "scripting"],
  "host_permissions": ["https://poseidon-scans.net/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vente auto Poseidon",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
